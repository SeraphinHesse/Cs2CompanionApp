<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Agora.Core — the political engine.

    This project deliberately has NO references to Game.*, Colossal.*, Unity.* or UnityEngine.
    That is what allows the determinism suite and the headless simulation harness to run under
    plain `dotnet test` on a machine with no copy of Cities: Skylines II. Adding a game reference
    here is a review-blocking defect (see CLAUDE.md).

    netstandard2.0, because the modding toolchain builds Agora.Mod as net48 and .NET Framework
    cannot reference netstandard2.1. Verified that nothing here needs a 2.1-only API: no Span<T>,
    no MathF, no Math.Clamp, no HashCode.Combine, no default interface members. If you reach for one
    of those, polyfill it inside Core rather than raising the target. Raising it breaks the toolchain
    build with NU1201, and the failure surfaces over in Agora.Mod, far from the actual cause.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>Agora.Core</AssemblyName>
    <RootNamespace>Agora.Core</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
