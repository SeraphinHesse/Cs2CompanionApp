<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Agora.Mod — the game glue.

    Two build modes, chosen automatically:

    1. TOOLCHAIN MODE (preferred; active when the in-game modding toolchain is installed).
       Imports the toolchain's Mod.props / Mod.targets, which supply:
         - the net48 target and the game's own mscorlib
         - the Unity.Entities source generators, required for SystemAPI / IJobEntity codegen
         - ModPostProcessor, which prepares the assembly for Windows/macOS/Linux
         - DeployWIP, which copies the build into the local Mods folder
         - the Publish path to PDX Mods
       Mod.props reads the CSII_* variables from the USER environment (the registry) rather than the
       process environment, so this works even in a shell that predates the toolchain install.

    2. FALLBACK MODE (no toolchain: CI, a fresh clone, a machine without the game).
       Targets netstandard2.1 and references the Managed folder directly. No post-processing and no
       publishing — enough to compile, and enough to catch API breakage.

    Force a mode with -p:UseCsiiToolchain=true|false.

    Every game reference is Private=false: the game already has these loaded, and copying them into
    the mod folder causes assembly identity conflicts at load time.
  -->

  <PropertyGroup>
    <CsiiToolPath>$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))</CsiiToolPath>
    <UseCsiiToolchain Condition="'$(UseCsiiToolchain)' == '' AND '$(CsiiToolPath)' != '' AND Exists('$(CsiiToolPath)\Mod.props')">true</UseCsiiToolchain>
    <UseCsiiToolchain Condition="'$(UseCsiiToolchain)' == ''">false</UseCsiiToolchain>
  </PropertyGroup>

  <Import Project="$(CsiiToolPath)\Mod.props" Condition="'$(UseCsiiToolchain)' == 'true'" />

  <!-- After the import, so these win over Mod.props. -->
  <PropertyGroup>
    <!-- Toolchain mode takes net48 from Mod.props; fallback mode matches the game's own TFM. -->
    <TargetFramework Condition="'$(UseCsiiToolchain)' != 'true'">netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Agora.Mod</AssemblyName>
    <RootNamespace>Agora.Mod</RootNamespace>

    <!-- Game assemblies pull in types we do not annotate; do not fail the build over their warnings. -->
    <NoWarn>$(NoWarn);CS0436;CS1701;CS1702</NoWarn>

    <!--
      MSB3277: System.Net.Http resolves to two different versions across the reference pack and the
      Unity assemblies. Harmless here — Agora never touches System.Net.Http, and at runtime the
      game's own assembly resolution applies rather than ours. Demoted to a message so a genuinely
      new warning stays visible instead of being lost in this one's noise.
    -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Mod.props already sets ManagedPath in toolchain mode; only compute it when it did not. -->
    <GameRoot Condition="'$(CSII_INSTALLATIONPATH)' != ''">$(CSII_INSTALLATIONPATH)</GameRoot>
    <GameRoot Condition="'$(GameRoot)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Cities Skylines II</GameRoot>
    <ManagedPath Condition="'$(ManagedPath)' == ''">$(GameRoot)\Cities2_Data\Managed</ManagedPath>

    <!-- Likewise LocalModsPath, used only by the fallback deploy at the bottom of this file. -->
    <LocalModsPath Condition="'$(LocalModsPath)' == '' AND '$(CSII_LOCALMODSPATH)' != ''">$(CSII_LOCALMODSPATH)</LocalModsPath>
    <LocalModsPath Condition="'$(LocalModsPath)' == ''">$(LOCALAPPDATA)\..\LocalLow\Colossal Order\Cities Skylines II\Mods</LocalModsPath>
    <DeployPath>$(LocalModsPath)\$(AssemblyName)</DeployPath>
  </PropertyGroup>

  <Target Name="CheckGamePath" BeforeTargets="BeforeBuild" Condition="!Exists('$(ManagedPath)')">
    <Error Text="Cities: Skylines II assemblies not found at '$(ManagedPath)'. Install the in-game modding toolchain (Options -> Modding), or edit GameRoot in Agora.Mod.csproj. Note that Agora.Core and its tests build without the game — only this project needs it." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Agora.Core\Agora.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Game">              <HintPath>$(ManagedPath)\Game.dll</HintPath>                        <Private>false</Private></Reference>
    <Reference Include="Colossal.Core">     <HintPath>$(ManagedPath)\Colossal.Core.dll</HintPath>               <Private>false</Private></Reference>
    <Reference Include="Colossal.Logging">  <HintPath>$(ManagedPath)\Colossal.Logging.dll</HintPath>            <Private>false</Private></Reference>
    <Reference Include="Colossal.UI">       <HintPath>$(ManagedPath)\Colossal.UI.dll</HintPath>                 <Private>false</Private></Reference>
    <Reference Include="Colossal.UI.Binding"><HintPath>$(ManagedPath)\Colossal.UI.Binding.dll</HintPath>        <Private>false</Private></Reference>
    <Reference Include="Colossal.IO.AssetDatabase"><HintPath>$(ManagedPath)\Colossal.IO.AssetDatabase.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Colossal.Localization"><HintPath>$(ManagedPath)\Colossal.Localization.dll</HintPath>    <Private>false</Private></Reference>
    <Reference Include="Colossal.Collections"><HintPath>$(ManagedPath)\Colossal.Collections.dll</HintPath>      <Private>false</Private></Reference>
    <Reference Include="Colossal.Mathematics"><HintPath>$(ManagedPath)\Colossal.Mathematics.dll</HintPath>      <Private>false</Private></Reference>
    <Reference Include="Unity.Entities">    <HintPath>$(ManagedPath)\Unity.Entities.dll</HintPath>              <Private>false</Private></Reference>
    <Reference Include="Unity.Collections"> <HintPath>$(ManagedPath)\Unity.Collections.dll</HintPath>           <Private>false</Private></Reference>
    <Reference Include="Unity.Mathematics"> <HintPath>$(ManagedPath)\Unity.Mathematics.dll</HintPath>           <Private>false</Private></Reference>
    <Reference Include="Unity.Burst">       <HintPath>$(ManagedPath)\Unity.Burst.dll</HintPath>                 <Private>false</Private></Reference>
    <Reference Include="UnityEngine">       <HintPath>$(ManagedPath)\UnityEngine.dll</HintPath>                 <Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedPath)\UnityEngine.CoreModule.dll</HintPath>  <Private>false</Private></Reference>
    <!-- Ships with the game — never add a Newtonsoft package on top of it. -->
    <Reference Include="Newtonsoft.Json">   <HintPath>$(ManagedPath)\Newtonsoft.Json.dll</HintPath>             <Private>false</Private></Reference>
  </ItemGroup>

  <Import Project="$(CsiiToolPath)\Mod.targets" Condition="'$(UseCsiiToolchain)' == 'true'" />

  <!--
    ModPostProcessor.exe and ModPublisher.exe were built against .NET 6, which is out of support and
    is not installed here (this machine has 8 and 9). Rather than installing an EOL runtime, roll the
    tools forward onto the newest available one. Verified: with DOTNET_ROLL_FORWARD=LatestMajor,
    ModPostProcessor starts and runs on .NET 9.

    Set as an Exec-scoped environment variable, deliberately. Setting DOTNET_ROLL_FORWARD globally
    would silently change version resolution for every other dotnet app on the machine.

    Mod.targets documents this override pattern: redefining a target after the import replaces it.
    Both bodies are otherwise copied from Mod.targets verbatim, so behaviour is unchanged apart from
    the added environment variable. If a future toolchain update changes those targets, this needs to
    be re-synced, or deleted outright once the tools ship against a supported runtime.

    Both are additionally gated on UseCsiiToolchain. Mod.targets sets NeedBuild to a literal
    'true'/'false' in BuildGetFullPaths, so its own bare Condition="'$(NeedBuild)'" is safe there; in
    fallback mode that target never runs, NeedBuild is empty, and MSBuild fails with MSB4113 rather
    than treating the empty string as false.
  -->
  <Target Name="RunModPostProcessor" AfterTargets="AfterBuild"
          Condition="'$(UseCsiiToolchain)' == 'true' AND '$(NeedBuild)' == 'true'">
    <Error Condition="!Exists('$(ModPostProcessorFullPath)')" Text="Post processor not found, please check the path: $(ModPostProcessorFullPath)" />
    <Message Text="Run post processor (rolled forward from .NET 6)" Importance="high" />
    <Exec Command="$(ModPostProcessorArgs)" LogStandardErrorAsError="true"
          EnvironmentVariables="DOTNET_ROLL_FORWARD=LatestMajor" />
  </Target>

  <!--
    Build the UI bundle AFTER DeployWIP, never before.

    webpack writes its output straight into $(LocalModsPath)\$(MOD.id), the same folder DeployWIP
    targets, and DeployWIP starts with RemoveDir. Verified: building C# after building the
    UI deletes Agora.Mod.mjs and Agora.Mod.css, leaving a mod the game loads with no interface and no
    error. Sequencing this after DeployWIP is what keeps the two halves of the mod in the folder
    together.

    webpack reads CSII_USERDATAPATH from the PROCESS environment and throws without it, unlike
    Mod.props which reads the registry. So pass it explicitly: MSBuild may well have been started from
    a shell older than the toolchain install.
  -->
  <PropertyGroup>
    <UiDir>$(MSBuildProjectDirectory)\..\..\ui</UiDir>
    <CsiiUserDataPath>$([System.Environment]::GetEnvironmentVariable('CSII_USERDATAPATH', 'EnvironmentVariableTarget.User'))</CsiiUserDataPath>
  </PropertyGroup>

  <Target Name="BuildUI" AfterTargets="DeployWIP" Condition="Exists('$(UiDir)\node_modules')">
    <Message Importance="high" Text="Building UI bundle into the deploy folder" />
    <Exec Command="npm run build" WorkingDirectory="$(UiDir)"
          EnvironmentVariables="CSII_USERDATAPATH=$(CsiiUserDataPath)" />
  </Target>

  <!--
    Say so out loud when the UI is skipped. The silent-skip failure mode has already bitten this
    project once (the old deploy target), and a mod deployed without its bundle looks identical to a
    working one from the build log alone.
  -->
  <Target Name="WarnUiNotBuilt" AfterTargets="DeployWIP" Condition="!Exists('$(UiDir)\node_modules')">
    <Warning Text="ui/node_modules not found, so no UI bundle was built or deployed. The mod will load with no interface. Run 'npm install' in ui/." />
  </Target>

  <Target Name="RunModPublisher" AfterTargets="Publish" Condition="'$(UseCsiiToolchain)' == 'true'">
    <Error Condition="!Exists('$(ModPublisherPath)')" Text="Mod publisher not found, please check the path: $(ModPublisherPath)" />
    <Message Text="Run mod publisher: $(ModPublisherArgs)" Importance="high" />
    <Exec Command="$(ModPublisherArgs)" LogStandardErrorAsError="true"
          EnvironmentVariables="DOTNET_ROLL_FORWARD=LatestMajor" />
  </Target>

  <!--
    Fallback deploy, for when the toolchain is absent and DeployWIP therefore does not exist.

    Conditioned on the GAME being present, not on the Mods folder existing. Gating on the Mods folder
    made this target skip silently and permanently on a machine that had never deployed before —
    nothing else creates that folder, so the condition could never become true. MakeDir creates it.
    CI has no game, so this correctly does nothing there.

    Also requires the toolchain to be genuinely ABSENT, not merely switched off. Otherwise
    `-p:UseCsiiToolchain=false` on a developer machine — the way to check the build still works for
    contributors without the toolchain — would deploy a netstandard2.1 assembly over the net48 one the
    game is meant to load, leaving a broken install behind as a side effect of a verification step.
  -->
  <Target Name="DeployMod" AfterTargets="Build"
          Condition="'$(UseCsiiToolchain)' != 'true' AND Exists('$(ManagedPath)') AND !Exists('$(CsiiToolPath)\Mod.props')">
    <MakeDir Directories="$(DeployPath)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployPath)" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetDir)Agora.Core.dll" DestinationFolder="$(DeployPath)" ContinueOnError="true" />
    <Message Importance="high" Text="Agora deployed to $(DeployPath) (fallback mode — no toolchain)" />
  </Target>

</Project>
