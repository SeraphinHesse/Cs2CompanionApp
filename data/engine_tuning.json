{
  "schemaVersion": 2,
  "_comment": "Every coefficient the engine uses. If a number affects behaviour it lives here, never in C#. One top-level section per engine packet, so two packets can never fight over the same key. Read it through Agora.Core.Tuning.EngineTuning — never parse it yourself. Values are M2 defaults; the simulation harness tunes them against real runs.",

  "blocs": {
    "_comment": "Packet 1. Blocs are wealth x education x age (3 x 5 x 4 = 60 per district). Weights say how much a bloc cares; ideals say what it wants. Both are derived from composition, then nudged by lived metrics.",
    "wealthTierThresholds": [0.33, 0.66],
    "minBlocPopulation": 25,
    "minBlocShare": 0.005,
    "compositionSmoothingAlpha": 0.25,

    "issueWeightPriors": {
      "services": 1.0, "costOfLiving": 1.0, "environment": 1.0,
      "transit": 1.0, "growth": 1.0, "heritageOrder": 1.0
    },
    "wealthWeightSensitivity": {
      "services": -0.35, "costOfLiving": -0.50, "environment": 0.30,
      "transit": -0.25, "growth": 0.20, "heritageOrder": 0.15
    },
    "educationWeightSensitivity": {
      "services": 0.10, "costOfLiving": -0.20, "environment": 0.35,
      "transit": 0.25, "growth": 0.10, "heritageOrder": -0.30
    },
    "ageWeightSensitivity": {
      "services": 0.25, "costOfLiving": 0.15, "environment": -0.10,
      "transit": -0.15, "growth": -0.25, "heritageOrder": 0.35
    },

    "idealBase": {
      "services": 0.20, "costOfLiving": 0.20, "environment": 0.10,
      "transit": 0.10, "growth": 0.00, "heritageOrder": 0.10
    },
    "wealthIdealSensitivity": {
      "services": -0.30, "costOfLiving": -0.45, "environment": 0.15,
      "transit": -0.20, "growth": 0.30, "heritageOrder": 0.20
    },
    "educationIdealSensitivity": {
      "services": 0.15, "costOfLiving": -0.05, "environment": 0.40,
      "transit": 0.30, "growth": 0.10, "heritageOrder": -0.35
    },
    "ageIdealSensitivity": {
      "services": 0.20, "costOfLiving": 0.10, "environment": -0.05,
      "transit": -0.10, "growth": -0.30, "heritageOrder": 0.40
    },

    "livedMetricWeightGain": 0.35,
    "livedMetricMaxShift": 0.50,
    "livedMetricSmoothingAlpha": 0.20,
    "weightFloor": 0.05,
    "weightCeiling": 3.00,
    "normalizeWeights": true,

    "discontentHappinessWeight": 0.50,
    "discontentServiceWeight": 0.30,
    "discontentCostWeight": 0.20,
    "referenceHappiness": 50.0
  },

  "parties": {
    "_comment": "Packet 2. EU parties split, merge, die below 3% across two consecutive elections, and revive if their core grievance resurges (plan section 3). NA party-level lifecycle is handled in `factions`.",
    "targetCountEu": 6,
    "minCountEu": 4,
    "maxCountEu": 7,
    "targetCountNa": 2,
    "minorPartyCountNa": 2,
    "maxPartiesTotal": 9,

    "archetypeSpreadSigma": 0.35,
    "minPlatformDistance": 0.15,
    "platformDriftPerCycle": 0.08,
    "platformDriftCapPerCycle": 0.20,
    "platformGrievanceResponsiveness": 0.30,

    "incumbencyBonus": 0.05,
    "incumbencyDecayPerTerm": 0.30,

    "deathVoteShareThreshold": 0.03,
    "deathConsecutiveElections": 2,
    "endangeredVoteShareThreshold": 0.05,
    "revivalGrievanceThreshold": 0.35,
    "revivalCooldownMonths": 36,

    "splitTensionThreshold": 0.45,
    "splitMinVoteShare": 0.08,
    "splitProbabilityPerCycle": 0.10,
    "mergeAffinityThreshold": 0.85,
    "mergeMaxCombinedVoteShare": 0.55,
    "mergeProbabilityPerCycle": 0.10,
    "newPartyEntryProbability": 0.05,

    "lifecycleCheckIntervalMonths": 12,

    "colorPalette": [
      "#C0392B", "#2E86C1", "#27AE60", "#F1C40F", "#8E44AD",
      "#E67E22", "#16A085", "#7F8C8D", "#D35400"
    ]
  },

  "factions": {
    "_comment": "Packet 3. NA theme: each party holds 2-4 factions with their own demographic support, demands and leader. The dominant faction writes the party platform each cycle.",
    "minPerParty": 2,
    "maxPerParty": 4,
    "targetPerParty": 3,

    "dominanceThreshold": 0.45,
    "dominanceHysteresis": 0.05,
    "platformWeightDominant": 0.60,
    "platformWeightOthers": 0.40,

    "internalTensionThreshold": 0.55,
    "supportDriftPerCycle": 0.10,
    "supportDriftCapPerCycle": 0.25,

    "splitProbabilityPerCycle": 0.12,
    "mergeAffinityThreshold": 0.88,
    "mergeProbabilityPerCycle": 0.10,
    "deathSupportThreshold": 0.08,
    "deathConsecutiveCycles": 2,
    "revivalGrievanceThreshold": 0.40,

    "leaderChangeProbabilityPerCycle": 0.15,
    "demandCountPerFaction": 2,
    "lifecycleCheckIntervalMonths": 12,
    "naPartyLifecycleProbability": 0.01,
    "archetypeSpreadSigma": 0.30
  },

  "affinity": {
    "_comment": "Packet 4. Affinity = issue proximity + incumbency + mandate performance + event modifiers + habitual loyalty + seeded noise. Noise is clamped so one tail draw cannot decide an election.",
    "distanceKernel": "linear",
    "distanceKernelSigma": 0.60,
    "issueWeight": 1.00,
    "baseAffinity": 0.50,

    "incumbencyBonus": 0.05,
    "incumbencyDiscontentPenalty": 0.10,
    "mandatePerformanceWeight": 0.15,
    "mandateFailurePenalty": 0.20,
    "eventModifierWeight": 0.25,
    "eventModifierDecayHalfLifeMonths": 9,
    "localGrievanceWeight": 0.20,
    "nationalMoodWeight": 0.10,
    "habitualLoyalty": 0.35,
    "loyaltyDecayPerMonth": 0.02,

    "noiseSigma": 0.03,
    "noiseClamp": 0.10,
    "softmaxTemperature": 0.35,
    "minPartyShare": 0.001,
    "tacticalVotingThresholdFptp": 0.05
  },

  "turnout": {
    "_comment": "Packet 5. Turnout scales with happiness and education and can flip close races. Child and teen multipliers are 0 — that is how minors are disenfranchised; the blocs still exist.",
    "base": 0.55,
    "happinessCoefficient": 0.20,
    "educationCoefficient": 0.15,
    "wealthCoefficient": 0.08,
    "discontentCoefficient": -0.10,
    "competitivenessCoefficient": 0.12,
    "campaignIntensityCoefficient": 0.05,
    "incumbentTermFatigue": 0.03,

    "ageBandMultipliers": { "child": 0.0, "teen": 0.0, "adult": 1.0, "elderly": 1.10 },

    "noiseSigma": 0.02,
    "floor": 0.10,
    "ceiling": 0.95,
    "referenceHappiness": 50.0,
    "referenceEducationIndex": 0.50,
    "snapElectionPenalty": 0.03
  },

  "polling": {
    "_comment": "Packet 6. Published polls under-sample low-education, low-turnout districts. The harness asserts the DIRECTION of that error, never the magnitude, so these two bias values must stay positive.",
    "errorSigma": 0.030,
    "educationUnderSampleBias": 0.040,
    "turnoutUnderSampleBias": 0.025,
    "houseEffectSigma": 0.015,

    "sampleSizeBase": 1000,
    "sampleSizeVariance": 0.20,
    "marginOfErrorMultiplier": 1.96,

    "publishIntervalDays": 7,
    "campaignWeeks": 26,
    "weeksBeforeElection": 26,

    "herdingFactor": 0.20,
    "errorDecayTowardElection": 0.60,
    "undecidedShareBase": 0.15,
    "undecidedDecayPerWeek": 0.08,

    "minPublishedShare": 0.005,
    "roundingDecimals": 3,
    "maxStoredPolls": 60,
    "pollsterCount": 3
  },

  "electionsPr": {
    "_comment": "Packet 7. EU theme: proportional list seats, 3-year terms, 5% threshold, modified Sainte-Lague with a 1.4 first divisor.",
    "termYears": 3,
    "totalSeats": 60,
    "seatsPerPopulation": 0.0,
    "minSeats": 21,
    "maxSeats": 120,
    "thresholdShare": 0.05,
    "method": "sainte-lague",
    "firstDivisor": 1.40,
    "districtSeatShare": 0.0,
    "campaignMonths": 6,
    "snapElectionMinMonthsSinceLast": 12,
    "snapElectionDelayMonths": 3,
    "minSeatsForRepresentation": 1
  },

  "electionsFptp": {
    "_comment": "Packet 8. NA theme: one seat per district plus a directly elected mayor, 4-year terms. primariesEnabled is an open decision (plan section 14) — leave it false.",
    "termYears": 4,
    "mayorTermYears": 4,
    "councilSeatsPerDistrict": 1,
    "minCouncilSeats": 9,
    "maxCouncilSeats": 45,
    "campaignMonths": 6,
    "thirdPartyPenalty": 0.35,
    "incumbentMayorBonus": 0.04,
    "districtSwingSigma": 0.02,
    "straightTicketFactor": 0.70,
    "mayorRunoffThreshold": 0.0,
    "tieMarginEpsilon": 1e-9,
    "primariesEnabled": false
  },

  "coalitions": {
    "_comment": "Packet 9. Formation ranks candidate coalitions by ideological closeness and size; stability decays monthly and takes shocks from failed mandates and severe events. Falling below collapseThreshold triggers a snap election.",
    "minSeatShareToGovern": 0.50,
    "formationMaxPartners": 4,
    "formationAttemptsMax": 3,
    "formationWindowMonths": 3,

    "ideologicalDistanceCap": 0.55,
    "distanceWeight": 0.60,
    "sizeWeight": 0.40,
    "grandCoalitionDistanceBonus": 0.10,
    "leadPartyMinSeatShare": 0.20,

    "minorityGovernmentAllowed": true,
    "minorityGovernmentPenalty": 0.25,

    "cohesionBase": 0.75,
