    "stabilityShockPerFailedMandate": 0.08,
    "stabilityShockPerSeverityPoint": 0.03,
    "stabilityRecoveryPerFulfilledMandate": 0.05,

    "collapseThreshold": 0.30,
    "collapseCheckIntervalMonths": 1,
    "snapElectionDelayMonths": 3
  },

  "mandates": {
    "_comment": "Packet 10. Mandates come from real measured deficits and are scored monthly against the live snapshot. Fulfilled raises happiness and legitimacy; defied lowers both and can trigger unrest. The player is never punished beyond a sanctioned effect.",
    "countPerTerm": 3,
    "maxActive": 6,
    "minDeficitToGenerate": 0.15,
    "targetImprovementFraction": 0.20,
    "horizonMonths": 24,
    "graceMonths": 3,
    "monitoringIntervalMonths": 1,
    "partialCreditThreshold": 0.60,
    "districtMandateShare": 0.50,

    "fulfilledHappinessBonus": 2.0,
    "defiedHappinessPenalty": 3.0,
    "partialHappinessBonus": 0.5,
    "fulfilledLegitimacyBonus": 0.05,
    "defiedLegitimacyPenalty": 0.08,
    "oppositionSurgeOnDefiance": 0.04,
    "unrestEventProbabilityOnDefiance": 0.25,
    "resolutionEffectDurationMonths": 12,
    "salienceFloor": 0.10,
    "stalledMetricGraceMonths": 3
  },

  "catalog": {
    "_comment": "Packet 11. Curated real history 1990 onward, then procedural mode. jitterEnabled and the procedural block are open decisions (plan section 14) — the keys exist so nothing hardcodes them, but do not build past the ratified shape.",
    "startYear": 1990,
    "catalogEndYear": 2026,

    "jitterEnabled": false,
    "jitterMonths": 0,

    "severityEffectScale": 0.20,
    "severityMax": 5,
    "majorSeverityThreshold": 4,
    "minMonthsBetweenMajorEvents": 3,
    "maxConcurrentEvents": 6,

    "includeGlobal": true,
    "globalEventWeight": 1.0,
    "regionalEventWeight": 1.0,

    "effectMagnitudeGlobalCap": 1.0,
    "effectDurationCapMonths": 240,

    "proceduralEnabled": true,
    "proceduralStartYear": 2027,
